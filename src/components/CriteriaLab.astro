                      ) : null,
                      <article
                        class="lab-table__row"
                        data-archive-card
                        data-group={entry.groupId}
                        data-bucket={displayBucket}
                        data-subsection={subsectionKey}
                        data-mod-scope={entryModScope(entry)}
