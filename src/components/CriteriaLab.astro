---
import LocalizedText from "./LocalizedText.astro";
import { uiCopy } from "../data/i18n";
import { criteriaArchive, criteriaGroups } from "../data/criteriaArchive";

const groupMap = new Map(criteriaGroups.map((group) => [group.id, group]));
const displayBucketMap = {
  foundational: "foundational",
  "lower-raw": "lower-raw",
  control: "control",
  "derived-legit": "derived-legit",
  "core-ebced-main": "focus",
  "core-ebced-summary": "secondary",
  "core-position": "secondary",
  supporting: "secondary",
  experimental: "experimental"
};
const displayBucketOrder = {
  foundational: 0,
  "lower-raw": 1,
  control: 2,
  "derived-legit": 3,
  focus: 4,
  secondary: 5,
  experimental: 6
};
const rawBucketOrder = {
  foundational: 0,
  "lower-raw": 1,
  control: 2,
  "derived-legit": 3,
  "core-ebced-main": 0,
  "core-ebced-summary": 1,
  "core-position": 2,
  supporting: 3,
  experimental: 4
};
const displayBucketLabels = {
  foundational: { tr: "Ham Temeller", en: "Raw foundations" },
  "lower-raw": { tr: "Aşağı Katman", en: "Lower layer" },
  control: { tr: "Kontrol", en: "Control" },
  "derived-legit": { tr: "Meşru Türevler", en: "Legitimate derivatives" },
  focus: { tr: "Ana Omurga", en: "Main spine" },
  secondary: { tr: "", en: "" },
  experimental: { tr: "Deneysel", en: "Experimental" }
};
const resolveDisplayBucket = (bucket) => (bucket ? displayBucketMap[bucket] ?? "secondary" : "secondary");

const parseCodeTokens = (code) =>
  code
    .split(".")
    .flatMap((part) =>
      Array.from(part.matchAll(/[0-9]+|[A-Za-z]+/g), (match) => {
        const value = match[0];
        return /^[0-9]+$/.test(value) ? Number(value) : value.toUpperCase();
      })
    );

const compareCodes = (left, right) => {
  const a = parseCodeTokens(left.code);
  const b = parseCodeTokens(right.code);
  const length = Math.max(a.length, b.length);

  for (let index = 0; index < length; index += 1) {
    const leftToken = a[index];
    const rightToken = b[index];

    if (leftToken === undefined) return -1;
    if (rightToken === undefined) return 1;

    if (typeof leftToken === "number" && typeof rightToken === "number") {
      if (leftToken !== rightToken) return leftToken - rightToken;
      continue;
    }

    if (typeof leftToken === "string" && typeof rightToken === "string") {
      const order = leftToken.localeCompare(rightToken, "tr");
      if (order !== 0) return order;
      continue;
    }

    if (typeof leftToken === "string") return -1;
    if (typeof rightToken === "string") return 1;
  }

  return left.code.localeCompare(right.code, "tr");
};

const compareSpineCodes = (left, right) => {
  const explicitOrder = {
    "ALMSF-6": 0,
    "ALMSF-5": 1,
    "ALMSF-7": 2,
    "ALMSF-8": 3,
    "ELMS-1": 4,
    "ELMS-2": 5
  };
  const leftOrder = explicitOrder[left.code] ?? 99;
  const rightOrder = explicitOrder[right.code] ?? 99;

  if (leftOrder !== rightOrder) return leftOrder - rightOrder;
  return compareCodes(left, right);
};

const uniqueMods = (entry) => [...new Set((entry.tests ?? []).flatMap((test) => test.mods))];
const detectModsFromText = (value = "") => {
  const mods = new Set();

  if (/\bmod\s*19\b|\(mod\s*19\)/i.test(value)) mods.add(19);
  if (/\bmod\s*7\b|\(mod\s*7\)/i.test(value)) mods.add(7);

  return mods;
};

const entryMods = (entry) => {
  const directMods = uniqueMods(entry);
  if (directMods.length) return directMods;

  if (entry.contextMods?.length) return entry.contextMods;

  const resultLikeFacts = (entry.facts ?? []).filter((fact) => /sonuç|ölçüt|kriter/i.test(fact.label.tr));
  const mods = new Set();

  resultLikeFacts.forEach((fact) => {
    [fact.value.tr, fact.value.en].forEach((value) => {
      detectModsFromText(value).forEach((mod) => mods.add(mod));
    });
  });

  return [...mods];
};

const entryModScope = (entry) => {
  const mods = entryMods(entry);
  if (mods.includes(19)) return "contains-19";
  if (mods.includes(7)) return "7-only";
  return "neutral";
};

const isDefaultVisibleEntry = (entry) => entryModScope(entry) === "contains-19";

const discoveryLine = (entry) => {
  if (entry.discovery.name === "Ahmet Düzduran") {
    return entry.discovery.date ?? "";
  }

  const tail = [entry.discovery.date, entry.discovery.place].filter(Boolean).join(" ");
  return tail ? `${entry.discovery.name} - ${tail}` : entry.discovery.name;
};
const shorten = (value, max = 160) => (value.length > max ? `${value.slice(0, max).trim()}…` : value);
const searchIndex = (entry) =>
  [
    entry.code,
    entry.subsection?.tr ?? "",
    entry.subsection?.en ?? "",
    entry.subsectionIntro?.tr ?? "",
    entry.subsectionIntro?.en ?? "",
    displayBucketLabels[resolveDisplayBucket(entry.bucket)].tr,
    displayBucketLabels[resolveDisplayBucket(entry.bucket)].en,
    entry.title.tr,
    entry.title.en,
    entry.summary.tr,
    entry.summary.en,
    entry.discovery.name === "Ahmet Düzduran" ? "" : entry.discovery.name,
    entry.discovery.place ?? "",
    ...(entry.tags ?? [])
  ]
    .join(" ")
    .toLowerCase();

const shouldSortBySubsection = (groupId) => groupId === "experimental-archive" || groupId === "hamim";

const buildSubsectionBlocks = (entries) => {
  const bucketBlocks = [];
  const bucketMap = new Map();

  entries.forEach((entry) => {
    const displayBucket = resolveDisplayBucket(entry.bucket);
    let bucketBlock = bucketMap.get(displayBucket);

    if (!bucketBlock) {
      bucketBlock = {
        key: displayBucket,
        label: displayBucketLabels[displayBucket],
        plainEntries: [],
        subsectionBlocks: [],
        subsectionMap: new Map()
      };
      bucketMap.set(displayBucket, bucketBlock);
      bucketBlocks.push(bucketBlock);
    }

    const subsectionKey = entry.subsection?.tr ?? "";
    if (!subsectionKey) {
      bucketBlock.plainEntries.push(entry);
      return;
    }

    let subsectionBlock = bucketBlock.subsectionMap.get(subsectionKey);
    if (!subsectionBlock) {
      subsectionBlock = {
        key: subsectionKey,
        title: entry.subsection,
        intro: entry.subsectionIntro,
        entries: []
      };
      bucketBlock.subsectionMap.set(subsectionKey, subsectionBlock);
      bucketBlock.subsectionBlocks.push(subsectionBlock);
    }

    subsectionBlock.entries.push(entry);
  });

  return bucketBlocks.map(({ subsectionMap, ...bucketBlock }) => bucketBlock);
};

const groupedCriteria = criteriaGroups.map((group) => ({
  ...group,
  entries: criteriaArchive
    .filter((entry) => entry.groupId === group.id)
    .sort((left, right) => {
      const leftDisplayBucket = displayBucketOrder[resolveDisplayBucket(left.bucket)] ?? 999;
      const rightDisplayBucket = displayBucketOrder[resolveDisplayBucket(right.bucket)] ?? 999;

      if (leftDisplayBucket !== rightDisplayBucket) return leftDisplayBucket - rightDisplayBucket;

      const leftBucket = left.bucket ? rawBucketOrder[left.bucket] : 999;
      const rightBucket = right.bucket ? rawBucketOrder[right.bucket] : 999;

      if (leftBucket !== rightBucket) return leftBucket - rightBucket;

      if (shouldSortBySubsection(group.id)) {
        const leftSubsectionOrder = left.subsectionOrder ?? 999;
        const rightSubsectionOrder = right.subsectionOrder ?? 999;

        if (leftSubsectionOrder !== rightSubsectionOrder) return leftSubsectionOrder - rightSubsectionOrder;

        const leftSubsection = left.subsection?.tr ?? "";
        const rightSubsection = right.subsection?.tr ?? "";
        const subsectionOrder = leftSubsection.localeCompare(rightSubsection, "tr");

        if (subsectionOrder !== 0) return subsectionOrder;

        const leftSubsectionEntryOrder = left.subsectionEntryOrder ?? 999;
        const rightSubsectionEntryOrder = right.subsectionEntryOrder ?? 999;

        if (leftSubsectionEntryOrder !== rightSubsectionEntryOrder) {
          return leftSubsectionEntryOrder - rightSubsectionEntryOrder;
        }
      }

      return group.id === "spine" ? compareSpineCodes(left, right) : compareCodes(left, right);
    })
})).filter((group) => group.entries.length > 0);

const groupCounts = groupedCriteria.map((group) => ({
  ...group,
  count: group.entries.filter(isDefaultVisibleEntry).length
}));

const totalCriteria = criteriaArchive.length;
const defaultVisibleCriteriaCount = criteriaArchive.filter(isDefaultVisibleEntry).length;
const totalInteractive = criteriaArchive.filter((entry) => entry.tests?.length).length;
const totalResearchers = new Set(criteriaArchive.map((entry) => entry.discovery.name)).size;
const totalProtocols = criteriaArchive.reduce((total, entry) => total + (entry.tests?.length ?? 0), 0);
const previewBlocks = (entry) => {
  if (entry.tests?.length) {
    return entry.tests.slice(0, 2).map((test) => ({
      label: test.label.tr,
      value: shorten(test.sequence, 170)
    }));
  }

  if (entry.facts?.length) {
    return entry.facts.slice(0, 2).map((fact) => ({
      label: fact.label.tr,
      value: shorten(fact.value.tr, 170)
    }));
  }

  return [{ label: "Özet", value: shorten(entry.summary.tr, 170) }];
};

const resultBlocks = (entry) => {
  if (entry.tests?.length) {
    const visibleTests = entry.tests.length <= 4 ? entry.tests : entry.tests.slice(0, 2);
    return visibleTests.map((test) => ({
      label: test.label.tr,
      value: test.mods.map((mod) => `≡ 0 (mod ${mod})`).join(" · ")
    }));
  }

  const factResult = entry.facts?.find((fact) => /sonuç|ölçüt|kriter/i.test(fact.label.tr));
  if (factResult) {
    return [{ label: factResult.label.tr, value: factResult.value.tr }];
  }

  const mods = uniqueMods(entry);
  if (mods.length) {
    return mods.map((mod) => ({ label: "Mod", value: `≡ 0 (mod ${mod})` }));
  }

  return [{ label: "Kayıt", value: "Yapısal eşitlik" }];
};

const groupToneClass = {
  besmele: "tone-basmala",
  spine: "tone-alms",
  "experimental-archive": "tone-experimental",
  hamim: "tone-hamim",
  fihrist: "tone-fihrist",
  special: "tone-special",
  "surah-ayah-19": "tone-surah-ayah-19"
};
---

<section class="lab-shell" data-archive-root>
  <header class="lab-header">
    <div class="lab-header__bar">
      <LocalizedText
        as="h1"
        class="lab-header__title"
        tr="Kur'an Yapısal Kodlamaları ile Mod 7 ve Mod 19 Bulguları"
        en="Quran structural codings with mod 7 and mod 19 findings"
      />
    </div>

    <div class="lab-header__meta">
      <div class="lab-header__stats">
        <span class="lab-header__stat">
          <span data-copy-lang="tr">Kriter</span>
          <strong>{totalCriteria}</strong>
        </span>
        <span class="lab-header__stat">
          <span data-copy-lang="tr">Test</span>
          <strong>{totalInteractive}</strong>
        </span>
        <span class="lab-header__stat">
          <span data-copy-lang="tr">Araştırmacı</span>
          <strong>{totalResearchers}</strong>
        </span>
        <span class="lab-header__stat">
          <span data-copy-lang="tr">Protokol</span>
          <strong>{totalProtocols}</strong>
        </span>
      </div>
    </div>
  </header>

  <div class="lab-controls">
    <div class="lab-filters" role="tablist" aria-label="Kriter grupları">
      <button type="button" class="lab-filter is-active" data-archive-filter="all">
        <span class="lab-filter__copy">
          <span data-copy-lang="tr">Tümü</span>
          <span data-copy-lang="en">All</span>
        </span>
        <strong class="lab-filter__count" data-archive-filter-count="all">{defaultVisibleCriteriaCount}</strong>
      </button>

      {
        groupCounts.map((group) => (
          <button type="button" class="lab-filter" data-archive-filter={group.id}>
            <span class="lab-filter__copy">
              <span data-copy-lang="tr">{group.title.tr}</span>
              <span data-copy-lang="en">{group.title.en}</span>
            </span>
            <strong class="lab-filter__count" data-archive-filter-count={group.id}>{group.count}</strong>
          </button>
        ))
      }
    </div>

    <div class="lab-controls__searchline">
      <label
        class="lab-search"
        data-placeholder-tr="Kriter kodu, başlık, kişi veya etiket ara"
        data-placeholder-en="Search by code, title, person, or tag"
      >
        <span class="lab-search__label">
          <span data-copy-lang="tr">Arama</span>
          <span data-copy-lang="en">Search</span>
        </span>
        <input type="search" data-archive-search />
      </label>

      <div class="lab-controls__tools">
        <label class="lab-toggle">
          <input type="checkbox" data-archive-mod7-toggle />
          <span class="lab-toggle__copy">
            <span data-copy-lang="tr">Mod 7 bulgularını da göster</span>
            <span data-copy-lang="en">Show mod 7 findings too</span>
          </span>
        </label>

        <div class="lab-toolbar__status">
          <span class="lab-toolbar__caption">
            <span data-copy-lang="tr">Gösterilen kayıt</span>
            <span data-copy-lang="en">Visible entries</span>
          </span>
          <strong class="lab-toolbar__value" data-archive-count>{defaultVisibleCriteriaCount}</strong>
        </div>
      </div>
    </div>
  </div>

  <div class="lab-catalogue">
    {
      groupedCriteria.map((group) => (
        <details
          class={`lab-section ${groupToneClass[group.id] ?? ""}`}
          data-group-section={group.id}
          hidden={!group.entries.some(isDefaultVisibleEntry)}
        >
          <summary class={`lab-section__banner ${groupToneClass[group.id] ?? ""}`}>
            <div class="lab-section__banner-copy">
              <LocalizedText as="h2" class="lab-section__title" tr={group.title.tr} en={group.title.en} />
              <LocalizedText as="p" class="lab-section__intro" tr={group.intro.tr} en={group.intro.en} />
            </div>

            <div class="lab-section__count">
              <span class="lab-section__count-copy">
                <span data-copy-lang="tr">Kayıt</span>
                <span data-copy-lang="en">Entries</span>
              </span>
              <strong data-group-visible-count>{group.entries.filter(isDefaultVisibleEntry).length}</strong>
            </div>
          </summary>

          <div class="lab-table">
            <p class="lab-table__scrollhint">
              <span data-copy-lang="tr">Tabloyu yana kaydırarak kodlama, ölçüt ve kayıt alanlarını birlikte okuyun.</span>
              <span data-copy-lang="en">Swipe sideways to read coding, measure, and record columns together.</span>
            </p>

            <div class="lab-table__head">
              <div class="lab-col lab-col--code">
                <span data-copy-lang="tr">No</span>
                <span data-copy-lang="en">No</span>
              </div>
              <div class="lab-col lab-col--summary">
                <span data-copy-lang="tr">Açıklama</span>
                <span data-copy-lang="en">Description</span>
              </div>
              <div class="lab-col lab-col--sequence">
                <span data-copy-lang="tr">Kodlama</span>
                <span data-copy-lang="en">Coding</span>
              </div>
              <div class="lab-col lab-col--result">
                <span data-copy-lang="tr">Ölçüt</span>
                <span data-copy-lang="en">Measure</span>
              </div>
              <div class="lab-col lab-col--detail">
                <span data-copy-lang="tr">Kayıt</span>
                <span data-copy-lang="en">Record</span>
              </div>
            </div>

            <div class="lab-table__body">
              {group.id === "hamim"
                ? buildSubsectionBlocks(group.entries).map((bucket) => [
                    bucket.plainEntries.map((entry) => {
                      const preview = previewBlocks(entry);
                      const results = resultBlocks(entry);
                      const displayBucket = resolveDisplayBucket(entry.bucket);

                      return (
                        <article
                          class="lab-table__row"
                          data-archive-card
                          data-group={entry.groupId}
                          data-bucket={displayBucket}
                          data-subsection=""
                          data-mod-scope={entryModScope(entry)}
                          data-search={searchIndex(entry)}
                          hidden={!isDefaultVisibleEntry(entry)}
                        >
                          <div class={`lab-cell lab-cell--code ${groupToneClass[group.id] ?? ""}`}>
                            <span class="lab-cell__mobile-label">
                              <span data-copy-lang="tr">No</span>
                              <span data-copy-lang="en">No</span>
                            </span>
                            <strong>{entry.code}</strong>
                          </div>

                          <div class="lab-cell lab-cell--summary">
                            <span class="lab-cell__mobile-label">
                              <span data-copy-lang="tr">Açıklama</span>
                              <span data-copy-lang="en">Description</span>
                            </span>
                            <LocalizedText as="h3" class="lab-cell__title" tr={entry.title.tr} en={entry.title.en} />
                            <LocalizedText as="p" class="lab-cell__text" tr={entry.summary.tr} en={entry.summary.en} />
                          </div>

                          <div class="lab-cell lab-cell--sequence">
                            <span class="lab-cell__mobile-label">
                              <span data-copy-lang="tr">Kodlama</span>
                              <span data-copy-lang="en">Coding</span>
                            </span>
                            {preview.map((item) => (
                              <div class="lab-seq">
                                <strong class="lab-seq__label">{item.label}</strong>
                                <span class="lab-seq__value">{item.value}</span>
                              </div>
                            ))}
                          </div>

                          <div class="lab-cell lab-cell--result">
                            <span class="lab-cell__mobile-label">
                              <span data-copy-lang="tr">Ölçüt</span>
                              <span data-copy-lang="en">Measure</span>
                            </span>
                            {results.map((item) => (
                              <div class="lab-resultline">
                                <strong class="lab-resultline__label">{item.label}</strong>
                                <span class="lab-resultline__value">{item.value}</span>
                              </div>
                            ))}
                          </div>

                          <div class="lab-cell lab-cell--detail">
                            <span class="lab-cell__mobile-label">
                              <span data-copy-lang="tr">Kayıt</span>
                              <span data-copy-lang="en">Record</span>
                            </span>
                            <p class="lab-cell__record">{discoveryLine(entry)}</p>
                            <button type="button" class="lab-card__button" data-archive-open={entry.id}>
                              <span data-copy-lang="tr">Detay</span>
                              <span data-copy-lang="en">Detail</span>
                            </button>
                          </div>
                        </article>
                      );
                    }),
                    bucket.subsectionBlocks.map((subsection) => (
                      <details
                        class="lab-subsection"
                        data-archive-subsection-block
                        data-subsection-key={subsection.key}
                        hidden={!subsection.entries.some(isDefaultVisibleEntry)}
                      >
                        <summary class="lab-subsection__summary">
                          <div class="lab-subsection__summary-copy">
                            <LocalizedText
                              as="h4"
                              class="lab-subsection__title"
                              tr={subsection.title?.tr ?? ""}
                              en={subsection.title?.en ?? ""}
                            />
                            {subsection.intro ? (
                              <LocalizedText
                                as="p"
                                class="lab-subsection__intro"
                                tr={subsection.intro.tr}
                                en={subsection.intro.en}
                              />
                            ) : null}
                          </div>

                          <div class="lab-subsection__count">
                            <span class="lab-subsection__count-copy">
                              <span data-copy-lang="tr">Kayıt</span>
                              <span data-copy-lang="en">Entries</span>
                            </span>
                            <strong data-subsection-visible-count>{subsection.entries.filter(isDefaultVisibleEntry).length}</strong>
                          </div>
                        </summary>

                        <div class="lab-subsection__body">
                          {subsection.entries.map((entry) => {
                            const preview = previewBlocks(entry);
                            const results = resultBlocks(entry);
                            const displayBucket = resolveDisplayBucket(entry.bucket);
                            const subsectionKey = entry.subsection?.tr ?? "";

                            return (
                              <article
                                class="lab-table__row"
                                data-archive-card
                                data-group={entry.groupId}
                                data-bucket={displayBucket}
                                data-subsection={subsectionKey}
                                data-mod-scope={entryModScope(entry)}
                                data-search={searchIndex(entry)}
                                hidden={!isDefaultVisibleEntry(entry)}
                              >
                                <div class={`lab-cell lab-cell--code ${groupToneClass[group.id] ?? ""}`}>
                                  <span class="lab-cell__mobile-label">
                                    <span data-copy-lang="tr">No</span>
                                    <span data-copy-lang="en">No</span>
                                  </span>
                                  <strong>{entry.code}</strong>
                                </div>

                                <div class="lab-cell lab-cell--summary">
                                  <span class="lab-cell__mobile-label">
                                    <span data-copy-lang="tr">Açıklama</span>
                                    <span data-copy-lang="en">Description</span>
                                  </span>
                                  <LocalizedText as="h3" class="lab-cell__title" tr={entry.title.tr} en={entry.title.en} />
                                  <LocalizedText as="p" class="lab-cell__text" tr={entry.summary.tr} en={entry.summary.en} />
                                </div>

                                <div class="lab-cell lab-cell--sequence">
                                  <span class="lab-cell__mobile-label">
                                    <span data-copy-lang="tr">Kodlama</span>
                                    <span data-copy-lang="en">Coding</span>
                                  </span>
                                  {preview.map((item) => (
                                    <div class="lab-seq">
                                      <strong class="lab-seq__label">{item.label}</strong>
                                      <span class="lab-seq__value">{item.value}</span>
                                    </div>
                                  ))}
                                </div>

                                <div class="lab-cell lab-cell--result">
                                  <span class="lab-cell__mobile-label">
                                    <span data-copy-lang="tr">Ölçüt</span>
                                    <span data-copy-lang="en">Measure</span>
                                  </span>
                                  {results.map((item) => (
                                    <div class="lab-resultline">
                                      <strong class="lab-resultline__label">{item.label}</strong>
                                      <span class="lab-resultline__value">{item.value}</span>
                                    </div>
                                  ))}
                                </div>

                                <div class="lab-cell lab-cell--detail">
                                  <span class="lab-cell__mobile-label">
                                    <span data-copy-lang="tr">Kayıt</span>
                                    <span data-copy-lang="en">Record</span>
                                  </span>
                                  <p class="lab-cell__record">{discoveryLine(entry)}</p>
                                  <button type="button" class="lab-card__button" data-archive-open={entry.id}>
                                    <span data-copy-lang="tr">Detay</span>
                                    <span data-copy-lang="en">Detail</span>
                                  </button>
                                </div>
                              </article>
                            );
                          })}
                        </div>
                      </details>
                    ))
                  ])
                : group.entries.map((entry, index) => {
                    const preview = previewBlocks(entry);
                    const results = resultBlocks(entry);
                    const previousEntry = group.entries[index - 1];
                    const displayBucket = resolveDisplayBucket(entry.bucket);
                    const previousDisplayBucket = previousEntry ? resolveDisplayBucket(previousEntry.bucket) : null;
                    const subsectionKey = entry.subsection?.tr ?? "";
                    const previousSubsectionKey = previousEntry?.subsection?.tr ?? "";
                    const suppressBucketHeading = displayBucket === "secondary";
                    const showBucketHeading = displayBucket !== previousDisplayBucket && !suppressBucketHeading;
                    const showSubsectionHeading = Boolean(subsectionKey) && (showBucketHeading || subsectionKey !== previousSubsectionKey);

                    return [
                      showBucketHeading ? (
                        <div class="lab-table__subgroup" data-archive-subgroup={`bucket:${displayBucket}`}>
                          <LocalizedText
                            as="h3"
                            class="lab-table__subgroup-title"
                            tr={displayBucketLabels[displayBucket].tr}
                            en={displayBucketLabels[displayBucket].en}
                          />
                        </div>
                      ) : null,
                      showSubsectionHeading ? (
                        <div class="lab-table__subgroup lab-table__subgroup--minor" data-archive-subgroup={`subsection:${subsectionKey}`}>
                          <LocalizedText
                            as="h4"
                            class="lab-table__subgroup-title lab-table__subgroup-title--minor"
                            tr={entry.subsection?.tr ?? ""}
                            en={entry.subsection?.en ?? ""}
                          />
                          {entry.subsectionIntro ? (
                            <LocalizedText
                              as="p"
