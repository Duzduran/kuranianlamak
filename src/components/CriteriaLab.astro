                    </h3>
                    <div class="lab-overview__facts">
                      {entry.walkthrough.map((step) => (
                        <article class="lab-overview__fact">
                          <LocalizedText as="h3" class="lab-overview__label" tr={step.label.tr} en={step.label.en} />
                          <LocalizedText as="p" class="lab-overview__value" tr={step.value.tr} en={step.value.en} />
                        </article>
                      ))}
