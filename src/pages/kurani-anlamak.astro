---
import Layout from "../layouts/Layout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import ScrollCue from "../components/ScrollCue.astro";
import { uiCopy } from "../data/i18n";

const l = (tr, en) => ({ tr, en });

const besmeleCriteriaGroups = [
  {
    id: "temel",
    range: "B1-B2",
    title: l("Temel ölçüler", "Core measures"),
    intro: l("İlk bakışta görünen ana ölçüler burada toplanır.", "The main measures visible at first glance gather here."),
    items: [
      ["B1", l("Harf sayısı", "Letter count"), "19", l("mod 19 = 0", "mod 19 = 0")],
      ["B2", l("Kelime, harf ve ebced dizilimi", "Word, letter, and abjad sequence"), "4 19 786", l("mod 19 = 0", "mod 19 = 0")]
    ]
  },
  {
    id: "harf",
    range: "B3-B4",
    title: l("Harf dizilimleri", "Letter sequences"),
    intro: l("Kelime sırası ve harf düzeni birlikte okunur.", "Word order and letter structure are read together."),
    items: [
      [
        "B3",
        l("Kelime sırası ve harf sayıları", "Word order and letter counts"),
        l("1 3 / 2 4 / 3 6 / 4 6 ve tersi", "1 3 / 2 4 / 3 6 / 4 6 and its reverse"),
        l("iki yönde mod 19 = 0", "mod 19 = 0 in both directions")
      ],
      [
        "B4",
        l("Kelime numarası ve kümülatif harf toplamları", "Word number and cumulative letter totals"),
        "1 3 / 2 7 / 3 13 / 4 19",
        l("mod 19 = 0", "mod 19 = 0")
      ]
    ]
  },
  {
    id: "ebced",
    range: "B5-B6.1",
    title: l("Ebced dizilimleri", "Abjad sequences"),
    intro: l("Ebced değerleri tek tek ve kümülatif biçimde izlenir.", "Abjad values are traced one by one and cumulatively."),
    items: [
      ["B5", l("Kelime sırası ve ebced değerleri", "Word order and abjad values"), "1 102 / 2 66 / 3 329 / 4 289", l("mod 19 = 0", "mod 19 = 0")],
      ["B6", l("Kelime numarası ve kümülatif ebced toplamları", "Word number and cumulative abjad totals"), "1 102 / 2 168 / 3 497 / 4 786", l("mod 19 = 0", "mod 19 = 0")],
      ["B6.1", l("Asal çarpan toplamları dizilimi", "Prime factor sum sequence"), "0 22 2 16 3 78 4 136", l("mod 19 = 0", "mod 19 = 0")]
    ]
  },
  {
    id: "ileri",
    range: "B7-B9",
    title: l("İleri ölçütler", "Advanced measures"),
    intro: l("Daha yoğun dizilimler ve birleşik yapılar bu katmanda yer alır.", "Denser sequences and composite structures appear in this layer."),
    items: [
      [
        "B7",
        l("Kelime ve harf ebced dizilimi", "Word and letter abjad sequence"),
        l("Düz, ters, basamak toplamı ve kayan pencere", "Forward, reverse, digit sum, and sliding window"),
        l("hepsi mod 19 = 0", "all give mod 19 = 0")
      ],
      ["B8", l("Harf ebcedlerinin kümülatif dizilimi", "Cumulative sequence of letter abjads"), "1 2 62 102 ... 4 786", l("mod 19 = 0", "mod 19 = 0")],
      [
        "B9",
        l("Kelime sıra no, harf sıra no ve harf ebced dizilimi", "Word no, letter no, and letter abjad sequence"),
        "1 1 2 2 60 ... 4 1 30 200 8 10 40",
        l("mod 19 = 0", "mod 19 = 0")
      ]
    ]
  }
];

const fihristHighlights = [
  {
    code: "32.2",
    result: l("114 = 19 x 6", "114 = 19 x 6"),
    title: l("Sure sayısı", "Number of surahs"),
    text: l(
      "Kur'an 114 sureden oluşur. Fihrist katmanında görülen ilk açık ölçü budur.",
      "The Qur'an consists of 114 surahs. This is the first clear measure visible at the index layer."
    )
  },
  {
    code: "23",
    result: l("57 = 19 x 3", "57 = 19 x 3"),
    title: l("Çift-tek dengesi", "Even-odd balance"),
    text: l(
      "Sure ve ayet sayılarının çift-tek dağılımı 30-27-57 dengesi üretir. Buradaki 57 sayısı 19 x 3'tür.",
      "The even-odd distribution of surah and verse counts produces a 30-27-57 balance. Here, 57 equals 19 x 3."
    )
  },
  {
    code: "31.1",
    result: l("mod 19 = 0", "mod 19 = 0"),
    title: l("Çift ayet sayıları", "Even verse counts"),
    text: l(
      "Yalnız çift ayet sayıları doğal sırayla yazıldığında oluşan dizi 19'a tam bölünür.",
      "When only the even verse counts are written in natural order, the resulting sequence is exactly divisible by 19."
    )
  },
  {
    code: "29.1",
    result: l("38 = 19 x 2", "38 = 19 x 2"),
    title: l("Sure ve ayet toplamlarının basamakları", "Digit sums of surah and verse totals"),
    text: l(
      "Sure ve ayet genel toplamlarının basamak toplamları birlikte 38 verir. Bu sayı 19 x 2'dir.",
      "The digit sums of the global surah and verse totals add up to 38. This number equals 19 x 2."
    )
  },
  {
    code: "31.5",
    result: l("mod 19 = 0", "mod 19 = 0"),
    title: l("Sure no + ayet sayısı + numarasız Besmele", "Surah no + verse count + unnumbered Basmala"),
    text: l(
      "Sure numarası, ayet sayısı ve numarasız Besmele değerleri birlikte doğal sırada yazıldığında oluşan dizi 19'a tam bölünür.",
      "When surah number, verse count, and unnumbered Basmala values are written together in natural order, the resulting sequence is exactly divisible by 19."
    )
  },
  {
    code: "32.4",
    result: l("mod 19 = 0", "mod 19 = 0"),
    title: l("Kümülatif ayet toplamları", "Cumulative verse totals"),
    text: l(
      "Surelerin ayet sayıları birikimli olarak toplandığında oluşan dizi 19'a tam bölünür.",
      "When the surah verse counts are accumulated, the resulting sequence is exactly divisible by 19."
    )
  }
];

const escapeHtml = (value) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");

const highlightNumericText = (value) =>
  escapeHtml(value).replace(/(\d+(?:\.\d+)?|mod|x|=)/g, '<span class="criteria-number">$1</span>');
---

<Layout
  title="Kur'an'ı Anlamak"
  description="Kur'an'ı anlamaya açılan yolculuk sayfası: meydan okuma, 19 örüntüleri, Besmele ölçütleri ve ayrıntılı okuma eşikleri."
>
  <section class="understanding-page-topbar">
    <a class="understanding-page-back" href="/">
      <span data-copy-lang="tr">Ana girişe dön</span>
      <span data-copy-lang="en">Back to main entry</span>
    </a>
  </section>

  <section class="home-hero">
    <div class="mx-auto max-w-4xl px-5 py-18 text-center md:px-8 md:py-28">
      <LocalizedText
        as="h1"
        class="mx-auto mt-6 max-w-4xl font-serif text-4xl leading-[1.08] text-balance text-[var(--c-ink)] md:text-7xl"
        tr="Kur'an'ı anlamak."
        en="Understanding the Qur'an."
      />
      <figure class="mx-auto mt-7 max-w-xl">
        <LocalizedText
          as="blockquote"
          class="font-serif text-xl leading-9 text-[var(--c-ink-soft)] md:text-2xl md:leading-10"
          tr="“Rabbim, ilmimi artır.”"
          en="“My Rabb, increase me in knowledge.”"
        />
        <figcaption class="mt-3 text-[0.74rem] font-semibold uppercase tracking-[0.24em] text-[var(--c-accent)]">
          Tâhâ 20:114
        </figcaption>
      </figure>

      <div class="home-hero__cue flex justify-center">
        <ScrollCue href="#ilk-esik" labelTr={uiCopy.tr.goDeeper} labelEn={uiCopy.en.goDeeper} class="scroll-cue--hero" />
      </div>
    </div>
  </section>

  <section
    class="home-journey"
    aria-label="Derinleşen akış"
    data-locale-label-tr="Derinleşen akış"
    data-locale-label-en="Descending journey"
  >
    <article id="ilk-esik" class="journey-stage journey-stage--light">
      <div class="journey-shell">
        <LocalizedText as="p" class="journey-label" tr="İlk durak" en="First threshold" />
        <LocalizedText
          as="blockquote"
          class="journey-quote"
          tr="“Bu kitap, mutlak gerçeğin ta kendisidir.”"
          en="“This Book is the very truth itself.”"
        />
        <p class="journey-reference">Bakara 2:2</p>
        <LocalizedText
          as="h2"
          class="journey-title journey-title--subtle"
          tr="Metin önce kendini tanıtır."
          en="The text first introduces itself."
        />
        <div class="mt-10 flex justify-center">
          <ScrollCue href="#ikinci-esik" />
        </div>
      </div>
    </article>

    <article id="ikinci-esik" class="journey-stage journey-stage--mid">
      <div class="journey-shell">
        <LocalizedText as="p" class="journey-label" tr="İkinci durak" en="Second threshold" />
        <LocalizedText
          as="blockquote"
          class="journey-quote"
          tr="“Eğer kulumuza indirdiğimizden yana şüphede iseniz, haydi onun benzeri bir sure getirin.”"
          en="“If you are in doubt about what We have sent down to Our servant, then bring a surah like it.”"
        />
        <p class="journey-reference">Bakara 2:23-24</p>
        <LocalizedText
          as="h2"
          class="journey-title journey-title--subtle"
          tr="Burada çağrı açılır."
          en="Here the challenge opens."
        />
        <div class="mt-10 flex justify-center">
          <ScrollCue href="#ucuncu-esik" />
        </div>
      </div>
    </article>

    <article id="ucuncu-esik" class="journey-stage journey-stage--deep">
      <div class="journey-shell">
        <LocalizedText as="p" class="journey-label" tr="Şüphe konuşur" en="Doubt speaks" />
        <LocalizedText
          as="blockquote"
          class="journey-quote journey-quote--deep"
          tr="“Bu, insan sözünden başka bir şey değildir.”"
          en="“This is nothing but human speech.”"
        />
        <p class="journey-reference journey-reference--deep">Müddessir 74:24-25</p>
        <LocalizedText
          as="h2"
          class="journey-title journey-title--subtle"
          tr="Burada itiraz görünür olur."
          en="Here the objection becomes visible."
        />
        <div class="mt-10 flex justify-center">
          <ScrollCue href="#dorduncu-esik" />
        </div>
      </div>
    </article>

    <article id="dorduncu-esik" class="journey-stage journey-stage--deeper">
      <div class="journey-shell">
        <LocalizedText as="p" class="journey-label" tr="Cevap gelir" en="The answer comes" />
        <LocalizedText
          as="blockquote"
          class="journey-quote journey-quote--deep"
          tr="“Onun üzerinde on dokuz vardır.”"
          en="“Over it are nineteen.”"
        />
        <p class="journey-reference journey-reference--deep">Müddessir 74:30-31</p>
        <LocalizedText
          as="h2"
          class="journey-title journey-title--subtle"
          tr="Buradan sonra örüntüler başlar."
          en="From here, patterns begin."
        />
        <div class="mt-10 flex justify-center">
          <ScrollCue href="#kod-19" />
        </div>
      </div>
    </article>

    <article id="kod-19" class="journey-stage journey-stage--code">
      <div class="journey-shell journey-shell--wide descent-shell">
        <header class="descent-intro reveal-step" data-reveal>
          <LocalizedText as="p" class="journey-label" tr="19 ile ilk temas" en="First contact with 19" />
          <LocalizedText
            as="h2"
            class="journey-title journey-title--descent"
            tr="İlk işaretler görünür olur."
            en="The first signs come into view."
          />
          <LocalizedText
            as="p"
            class="journey-text journey-text--descent-intro"
            tr="Önce yorum değil, görünen sayılar var. Her örnek tek başına anlaşılır; birlikte okunduğunda aynı sayının girişte, bütünde ve ilk vahiyde belirdiği görülür."
            en="Start not with interpretation, but with visible numbers. Each example is understandable on its own; read together, they show the same number appearing at the opening, in the whole, and at the first revelation."
          />
        </header>

        <div class="descent-rail">
          <article class="descent-step reveal-step" data-reveal style="--step-depth: 0;">
            <div class="descent-step__inner">
              <div class="descent-panel">
                <LocalizedText as="p" class="descent-panel__eyebrow" tr="İlk ayet" en="First verse" />
                <LocalizedText as="p" class="descent-panel__value" tr="19 harf" en="19 letters" />
                <LocalizedText as="h3" class="descent-panel__title" tr="Besmele" en="Basmala" />
                <LocalizedText
                  as="p"
                  class="descent-panel__text"
                  tr="Kur'an'ın açılış cümlesi olan Besmele 19 harftir. İlk temas en küçük ölçekte başlar."
                  en="The Qur'an's opening formula, the Basmala, contains 19 letters. The first contact begins at the smallest scale."
                />
              </div>
            </div>
          </article>

          <article class="descent-step reveal-step" data-reveal style="--step-depth: 1;">
            <div class="descent-step__inner">
              <div class="descent-panel">
                <LocalizedText as="p" class="descent-panel__eyebrow" tr="Bütün" en="Whole" />
                <LocalizedText as="p" class="descent-panel__value" tr="114 sure" en="114 surahs" />
                <LocalizedText as="h3" class="descent-panel__title" tr="Kur'an" en="The Qur'an" />
                <LocalizedText
                  as="p"
                  class="descent-panel__text"
                  tr="Kur'an 114 sureden oluşur. 114 = 19 x 6. Aynı sayı bu kez bütün kitabın ölçüsünde görünür."
                  en="The Qur'an consists of 114 surahs. 114 = 19 x 6. The same number now appears at the scale of the whole book."
                />
              </div>
            </div>
          </article>

          <article class="descent-step reveal-step" data-reveal style="--step-depth: 2;">
            <div class="descent-step__inner">
              <div class="descent-panel">
                <LocalizedText as="p" class="descent-panel__eyebrow" tr="İlk vahiy" en="First revelation" />
                <p class="descent-panel__value">96 / 19</p>
                <LocalizedText as="h3" class="descent-panel__title" tr="Alak suresi" en="Surah Al-Alaq" />
                <LocalizedText
                  as="p"
                  class="descent-panel__text"
                  tr="İlk vahyedilen sure 96. suredir; sondan sayıldığında 19. sıradadır. Aynı iz bu kez başlangıç noktasında görünür."
                  en="The first revealed surah is number 96; counted from the end, it stands in the 19th place. The same trace appears again at the point of beginning."
                />
              </div>
            </div>
          </article>
        </div>

        <div class="mt-12 flex justify-center">
          <ScrollCue href="#kod-19-derin" />
        </div>
      </div>
    </article>

    <article id="kod-19-derin" class="journey-stage journey-stage--code-layer">
      <div class="journey-shell journey-shell--wide descent-shell">
        <header class="descent-intro reveal-step" data-reveal>
          <LocalizedText as="p" class="journey-label" tr="İkinci aşama" en="Second stage" />
          <LocalizedText
            as="h2"
            class="journey-title journey-title--descent"
            tr="Sayı artık parçaları da bağlar."
            en="The number now begins to bind parts together."
          />
          <LocalizedText
            as="p"
            class="journey-text journey-text--descent-intro"
            tr="Şimdi sayı tek başına görünmekle kalmaz. Bir eksik tamamlanır, bir sure kendi içinde yoğunlaşır ve Besmele de tek başına açık bir örnek haline gelir."
            en="Now the number does not merely appear on its own. A missing part is completed, a surah condenses it within itself, and the Basmala itself becomes a clear example on its own."
          />
        </header>

        <div class="descent-rail">
          <article class="descent-step reveal-step" data-reveal style="--step-depth: 0;">
            <div class="descent-step__inner">
              <article class="descent-panel descent-panel--trigger">
                <button type="button" class="descent-panel__button" data-detail-open="kayip-besmele">
                  <LocalizedText as="p" class="descent-panel__eyebrow" tr="Eksik ve tamam" en="Missing and complete" />
                  <p class="descent-panel__value">27 + 30 = 57</p>
                  <LocalizedText as="h3" class="descent-panel__title" tr="Kayıp Besmele" en="Missing Basmala" />
                  <LocalizedText
                    as="p"
                    class="descent-panel__text"
                    tr="9. surenin başındaki eksik Besmele, 27. surenin 30. ayetindeki Besmele ile tamamlanır. 57 = 19 x 3."
                    en="The missing Basmala at the start of Surah 9 is completed by the Basmala in verse 30 of Surah 27. 57 = 19 x 3."
                  />
                  <LocalizedText as="span" class="descent-panel__cta" tr={uiCopy.tr.explore} en={uiCopy.en.explore} />
                </button>
              </article>
            </div>
          </article>

          <article class="descent-step reveal-step" data-reveal style="--step-depth: 1;">
            <div class="descent-step__inner">
              <div class="descent-panel">
                <LocalizedText as="p" class="descent-panel__eyebrow" tr="Sure içi yoğunluk" en="Internal density" />
                <LocalizedText as="p" class="descent-panel__value" tr="19 ayet / 285 harf" en="19 verses / 285 letters" />
                <LocalizedText as="h3" class="descent-panel__title" tr="İlk inen sure" en="First revealed surah" />
                <LocalizedText
                  as="p"
                  class="descent-panel__text"
                  tr="96. sure 19 ayettir. Bu 19 ayetin toplamı 285 harftir ve 285 = 19 x 15'tir. Sayı, surenin kendi içinde de kapanır."
                  en="Surah 96 has 19 verses. Those 19 verses total 285 letters, and 285 = 19 x 15. The number closes again within the surah itself."
                />
              </div>
            </div>
          </article>

          <article class="descent-step reveal-step" data-reveal style="--step-depth: 2;">
            <div class="descent-step__inner">
              <div class="descent-panel">
                <LocalizedText as="p" class="descent-panel__eyebrow" tr="4 kelime, 19 harf, 786 ebced" en="4 words, 19 letters, 786 abjad" />
                <p class="descent-panel__value">419786</p>
                <LocalizedText as="h3" class="descent-panel__title" tr="Üç ölçü tek dizilimde birleşir" en="Three measures merge into one sequence" />
                <LocalizedText
                  as="p"
                  class="descent-panel__text"
                  tr="Besmele'nin kelime sayısı, harf sayısı ve ebced toplamı doğal sırayla birlikte okunduğunda 419786 elde edilir. Bu sayı 19'a tam bölünür."
                  en="When the Basmala's word count, letter count, and abjad total are read together in natural order, the result is 419786. This number is exactly divisible by 19."
                />
              </div>
            </div>
          </article>
        </div>

        <dialog class="number-dialog" data-detail-dialog="kayip-besmele">
          <div class="number-dialog__panel">
            <div class="number-dialog__top">
              <div>
                <LocalizedText as="p" class="journey-label" tr="Kayıp Besmele" en="Missing Basmala" />
                <LocalizedText as="h2" class="number-dialog__title" tr="Eksik olan burada tamamlanır" en="What is missing is completed here" />
              </div>
              <button type="button" class="number-dialog__close" data-detail-close="kayip-besmele">
                <span data-copy-lang="tr">{uiCopy.tr.close}</span>
                <span data-copy-lang="en">{uiCopy.en.close}</span>
              </button>
            </div>

            <div class="pattern-list">
              <article class="pattern-item">
                <LocalizedText as="h3" tr="Eksik başlangıç" en="Missing beginning" />
                <LocalizedText
                  as="p"
                  tr="Normalde sure başlarında görülen Besmele, 9. surenin başında yer almaz."
                  en="The Basmala normally seen at the start of surahs does not appear at the beginning of surah 9."
                />
              </article>

              <article class="pattern-item">
                <LocalizedText as="h3" tr="Tamamlanan sayı" en="The completed total" />
                <LocalizedText
                  as="p"
                  tr="Bu eksik, Neml suresinin 30. ayetindeki Besmele ile tamamlanır; toplam böylece 114 olur. 114 = 19 x 6."
                  en="This absence is completed by the Basmala in verse 30 of Surah Al-Naml; the total thus becomes 114. 114 = 19 x 6."
                />
              </article>

              <article class="pattern-item">
                <LocalizedText as="h3" tr="19 ilişkisi" en="The 19 relation" />
                <LocalizedText
                  as="p"
                  tr="Eksik Besmele'nin tamamlandığı yer Neml suresinin 30. ayetidir. Burada 27 sure numarası, 30 ise ayet numarasıdır. Bu iki sayı toplandığında 57 elde edilir. 57 = 19 x 3."
                  en="The place where the missing Basmala is completed is verse 30 of Surah Al-Naml. Here, 27 is the surah number and 30 is the verse number. When these two numbers are added, the result is 57. 57 = 19 x 3."
                />
              </article>
            </div>
          </div>
        </dialog>

        <div class="mt-12 flex justify-center">
          <ScrollCue href="#besmele-olcutleri" />
        </div>
      </div>
    </article>

    <article id="besmele-olcutleri" class="journey-stage journey-stage--criteria">
      <div class="journey-shell journey-shell--wide descent-shell">
        <header class="descent-intro reveal-step" data-reveal>
          <LocalizedText as="p" class="journey-label" tr="Besmele ölçütleri" en="Basmala criteria" />
          <LocalizedText
            as="h2"
            class="journey-title journey-title--descent"
            tr="Burada Besmele adım adım okunur."
            en="Here the Basmala is read step by step."
          />
          <LocalizedText
            as="p"
            class="journey-text journey-text--descent-intro"
            tr="Bundan sonra tek bir cümle üzerinde ilerliyoruz. İlk kez geliyorsanız önce B1-B2'yi açın; diğer gruplar bunun üzerine kurulur."
            en="From this point on, we stay with a single sentence. If this is your first visit, start with B1-B2; the other groups are built on top of that layer."
          />
        </header>

        <div class="descent-rail descent-rail--criteria">
          {
            besmeleCriteriaGroups.map((group, index) => (
              <article class="descent-step reveal-step" data-reveal style={`--step-depth: ${index};`}>
                <div class="descent-step__inner">
                  <article class="descent-panel descent-panel--trigger descent-panel--gate">
                    <button type="button" class="descent-panel__button" data-criteria-open={group.id}>
                      <p class="descent-panel__eyebrow">{group.range}</p>
                      <LocalizedText as="h3" class="descent-panel__title" tr={group.title.tr} en={group.title.en} />
                      <LocalizedText as="p" class="descent-panel__text" tr={group.intro.tr} en={group.intro.en} />
                      <div class="descent-panel__list" aria-hidden="true">
                        {
                          group.items.slice(0, 2).map(([code, label]) => (
                            <p class="descent-panel__list-item">
                              <span class="descent-panel__list-code">{code}</span>
                              <span data-copy-lang="tr">{label.tr}</span>
                              <span data-copy-lang="en">{label.en}</span>
                            </p>
                          ))
                        }
                      </div>
