---
import Layout from "../../layouts/Layout.astro";
import { documents, documentFiles, documentFileName, type SiteDocument } from "../../data/documents";

export function getStaticPaths() {
  return documents.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

interface Props {
  doc: SiteDocument;
}

const { doc } = Astro.props;
const files = documentFiles(doc.slug);
const fullTitle = `${doc.author} · ${doc.title}`;
---

<Layout title={fullTitle} description={doc.description}>
  <article class="doc">
    <header class="doc__topbar">
      <a class="doc__back" href="/dosyalar">
        <span data-copy-lang="tr">Tüm dosyalar</span>
        <span data-copy-lang="en">All files</span>
      </a>
    </header>

    <p class="doc__eyebrow">{doc.author}</p>
    <h1 class="doc__title">{doc.title}</h1>
    <p class="doc__lead">{doc.description}</p>

    <div class="doc__actions">
      <a class="doc__button doc__button--primary" href={files.docx} download={documentFileName(doc, "docx")}>
        <span data-copy-lang="tr">Word olarak indir</span>
        <span data-copy-lang="en">Download Word</span>
        <small>.docx</small>
      </a>
      <a class="doc__button" href={files.pdf} download={documentFileName(doc, "pdf")}>
        <span data-copy-lang="tr">PDF olarak indir</span>
        <span data-copy-lang="en">Download PDF</span>
        <small>.pdf</small>
      </a>
      <a class="doc__button doc__button--ghost" href={files.preview} target="_blank" rel="noopener">
        <span data-copy-lang="tr">Yeni sekmede aç</span>
        <span data-copy-lang="en">Open in new tab</span>
      </a>
      <span class="doc__pages">
        {doc.pages} <span data-copy-lang="tr">sayfa</span><span data-copy-lang="en">pages</span>
      </span>
    </div>

    <div class="doc__paper">
      <iframe
        class="doc__frame"
        src={files.preview}
        title={fullTitle}
        loading="eager"
        data-doc-frame
      ></iframe>
    </div>
  </article>
</Layout>

<script>
  // Önizleme aynı kaynaktan geldiği için iframe yüksekliği içeriğe göre ayarlanır;
  // böylece belge, sayfanın kendi kaydırmasıyla okunur.
  const fitFrame = (frame: HTMLIFrameElement) => {
    const docEl = frame.contentDocument?.documentElement;
    if (!docEl) return;
    frame.style.height = `${docEl.scrollHeight}px`;
  };

  document.querySelectorAll<HTMLIFrameElement>("[data-doc-frame]").forEach((frame) => {
    const attach = () => {
      fitFrame(frame);
      const body = frame.contentDocument?.body;
      if (body && "ResizeObserver" in window) {
        new ResizeObserver(() => fitFrame(frame)).observe(body);
      }
    };

    if (frame.contentDocument?.readyState === "complete" && frame.contentDocument.body?.childElementCount) {
      attach();
    }
    frame.addEventListener("load", attach);
    window.addEventListener("resize", () => fitFrame(frame));
  });
</script>

<style>
  .doc {
    width: min(1120px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4.2rem;
    color: var(--theme-ink);
  }

  .doc__topbar {
    margin-bottom: 3rem;
  }

  .doc__back {
    color: var(--theme-muted);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .doc__back:hover {
    color: var(--theme-ink-strong);
  }

  .doc__eyebrow {
    margin: 0 0 0.7rem;
    color: var(--theme-muted);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .doc__title {
    margin: 0;
    font-family: var(--font-serif);
    color: var(--theme-ink-strong);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .doc__lead {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: var(--theme-ink-soft);
    font-size: 1rem;
    line-height: 1.75;
  }

  .doc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 1.6rem 0 1.8rem;
  }

  .doc__button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.62rem 1rem;
    border: 1px solid var(--theme-border-strong);
    border-radius: 999px;
    color: var(--theme-ink-strong);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .doc__button small {
    color: var(--theme-muted);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .doc__button:hover,
  .doc__button:focus-visible {
    border-color: var(--theme-link);
    color: var(--theme-link);
    outline: none;
  }

  .doc__button--primary {
    background: var(--theme-link);
    border-color: var(--theme-link);
    color: var(--theme-surface);
  }

  .doc__button--primary small {
    color: inherit;
    opacity: 0.75;
  }

  .doc__button--primary:hover,
  .doc__button--primary:focus-visible {
    background: transparent;
  }

  .doc__button--ghost {
    border-color: transparent;
    color: var(--theme-muted);
  }

  .doc__pages {
    margin-left: auto;
    color: var(--theme-muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .doc__paper {
    border: 1px solid var(--theme-border);
    border-radius: 6px;
    background: #ffffff;
    overflow: hidden;
  }

  .doc__frame {
    display: block;
    width: 100%;
    height: 80vh;
    border: 0;
    background: #ffffff;
  }

  @media (max-width: 760px) {
    .doc {
      width: min(100vw - 1rem, 100%);
      padding-bottom: 3rem;
    }

    .doc__topbar {
      margin-bottom: 2.2rem;
    }

    .doc__pages {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
