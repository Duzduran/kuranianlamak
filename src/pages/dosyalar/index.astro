---
import Layout from "../../layouts/Layout.astro";
import LocalizedText from "../../components/LocalizedText.astro";
import { documents, documentFiles, documentFileName } from "../../data/documents";
---

<Layout
  title="Dosyalar"
  description="Kur'an'ı Anlamak çalışmalarına ait kayıtlı dosyalar. Her dosya sitede açılabilir, Word veya PDF olarak indirilebilir."
>
  <section class="files">
    <header class="files__topbar">
      <a class="files__back" href="/">
        <span data-copy-lang="tr">Ana girişe dön</span>
        <span data-copy-lang="en">Back to main entry</span>
      </a>
    </header>

    <LocalizedText as="p" class="files__eyebrow" tr="Arşiv" en="Archive" />
    <LocalizedText as="h1" class="files__title" tr="Dosyalar" en="Files" />
    <LocalizedText
      as="p"
      class="files__lead"
      tr="Çalışmalara ait belgeler burada kayıtlı tutulur. Dosyayı sitede açabilir, Word ya da PDF olarak indirebilirsiniz."
      en="Documents from the studies are kept here. Open a file on the site, or download it as Word or PDF."
    />

    <ul class="files__list">
      {
        documents.map((doc, index) => {
          const files = documentFiles(doc.slug);
          return (
            <li class="files__row">
              <span class="files__index">{String(index + 1).padStart(2, "0")}</span>
              <div class="files__body">
                <a class="files__name" href={`/dosyalar/${doc.slug}`}>
                  {doc.author} · {doc.title}
                </a>
                <p class="files__text">{doc.description}</p>
                <p class="files__meta">
                  <span>
                    {doc.pages} <span data-copy-lang="tr">sayfa</span><span data-copy-lang="en">pages</span>
                  </span>
                  <a href={files.docx} download={documentFileName(doc, "docx")}>Word</a>
                  <a href={files.pdf} download={documentFileName(doc, "pdf")}>PDF</a>
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
</Layout>

<style>
  .files {
    width: min(980px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4.2rem;
    color: var(--theme-ink);
  }

  .files__topbar {
    margin-bottom: 3.8rem;
  }

  .files__back {
    color: var(--theme-muted);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .files__back:hover {
    color: var(--theme-ink-strong);
  }

  .files__eyebrow {
    margin: 0 0 0.9rem;
    color: var(--theme-muted);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .files__title {
    margin: 0;
    font-family: var(--font-serif);
    color: var(--theme-ink-strong);
    font-size: clamp(2.2rem, 4.4vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .files__lead {
    max-width: 62ch;
    margin: 1.1rem 0 0;
    color: var(--theme-ink-soft);
    font-size: 1rem;
    line-height: 1.78;
  }

  .files__list {
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .files__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.3rem 0;
    border-top: 1px solid var(--theme-border);
  }

  .files__row:last-child {
    border-bottom: 1px solid var(--theme-border);
  }

  .files__index {
    color: var(--theme-muted-soft);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    padding-top: 0.35rem;
  }

  .files__name {
    font-family: var(--font-serif);
    color: var(--theme-ink-strong);
    font-size: clamp(1.2rem, 1.7vw, 1.55rem);
    line-height: 1.25;
    text-decoration: none;
  }

  .files__name:hover,
  .files__name:focus-visible {
    color: var(--theme-link);
  }

  .files__text {
    margin: 0.5rem 0 0;
    color: var(--theme-ink-soft);
    font-size: 0.97rem;
    line-height: 1.7;
  }

  .files__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.6rem 0 0;
    color: var(--theme-muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .files__meta a {
    color: var(--theme-link);
    text-decoration: none;
  }

  .files__meta a:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .files {
      width: min(100vw - 1rem, 100%);
      padding-bottom: 3.5rem;
    }

    .files__topbar {
      margin-bottom: 3rem;
    }

    .files__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
